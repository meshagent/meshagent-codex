+#[test]
+fn provider_scoped_logout_preserves_other_credentials() -> Result<()> {
+    for (args, meshagent_session_remains, openai_auth_remains) in [
+        (vec!["logout", "--provider=openai"], true, false),
+        (vec!["logout", "--provider=meshagent"], false, true),
+        (vec!["logout"], false, false),
+    ] {
+        let codex_home = TempDir::new()?;
+        write_file_auth_config(codex_home.path())?;
+        login_with_api_key(
+            codex_home.path(),
+            "sk-openai-test",
+            AuthCredentialsStoreMode::File,
+            AuthKeyringBackendKind::default(),
+        )?;
+        let settings_dir = codex_home.path().join(".meshagent");
+        std::fs::create_dir_all(&settings_dir)?;
+        let settings_path = settings_dir.join("settings.json");
+        std::fs::write(
+            &settings_path,
+            serde_json::to_vec_pretty(&json!({
+                "active_user_id": "mesh-user",
+                "users": {
+                    "mesh-user": {
+                        "profile": {
+                            "id": "mesh-user",
+                            "email": "mesh@example.test"
+                        },
+                        "api_url": "https://mesh.example.test",
+                        "session": {
+                            "access_token": "mesh-token",
+                            "refresh_token": "mesh-refresh",
+                            "expires_at": 4102444800_i64
+                        },
+                        "project": {
+                            "active_project": "project-1"
+                        }
+                    }
+                }
+            }))?,
+        )?;
+
+        codex_command(codex_home.path())?
+            .args(args)
+            .assert()
+            .success();
+
+        let settings: Value = serde_json::from_slice(&std::fs::read(&settings_path)?)?;
+        assert_eq!(
+            settings["users"]["mesh-user"]["session"].is_object(),
+            meshagent_session_remains
+        );
+        assert_eq!(
+            codex_home.path().join("auth.json").exists(),
+            openai_auth_remains
+        );
+    }
+    Ok(())
+}
