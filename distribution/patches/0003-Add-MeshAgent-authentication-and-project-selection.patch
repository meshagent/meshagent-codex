+pub async fn run_login_with_meshagent(api_url: Option<String>) -> ! {
+    let auth = meshagent_auth_or_exit();
+    let attempt = match auth.start_login(api_url.as_deref()) {
+        Ok(attempt) => attempt,
+        Err(error) => {
+            eprintln!("Error starting MeshAgent login: {error}");
+            std::process::exit(1);
+        }
+    };
+    eprintln!(
+        "Waiting for MeshAgent login on http://localhost:8765.\nIf your browser did not open, navigate to:\n\n{}",
+        attempt.auth_url
+    );
+    if let Err(error) = attempt.open_browser() {
+        tracing::warn!("failed to open MeshAgent login URL: {error}");
+    }
+    match attempt.complete().await {
+        Ok(result) => {
+            if result.account.active_project.is_none() {
+                match select_meshagent_project(&result.projects) {
+                    Ok(project_id) => {
+                        if let Err(error) = auth.set_active_project(&project_id) {
+                            eprintln!("Error selecting MeshAgent project: {error}");
+                            std::process::exit(1);
+                        }
+                    }
+                    Err(error) => {
+                        eprintln!("Error selecting MeshAgent project: {error}");
+                        std::process::exit(1);
+                    }
+                }
+            }
+            eprintln!("Successfully logged in to MeshAgent");
+            std::process::exit(0);
+        }
+        Err(error) => {
+            eprintln!("Error logging in to MeshAgent: {error}");
+            std::process::exit(1);
+        }
+    }
+}
 
