@@ -0,0 +1,184 @@
+//! MeshAgent OAuth and multi-account session storage.
+
+mod oauth;
+mod storage;
+
+pub use oauth::MeshAgentLoginAttempt;
+pub use oauth::MeshAgentLoginCancel;
+pub use oauth::MeshAgentLoginResult;
+pub use oauth::MeshAgentProject;
+pub use storage::MeshAgentAccount;
+
+use codex_http_client::ClientRouteClass;
+use codex_http_client::HttpClient;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use std::io;
+use std::path::PathBuf;
+
+use crate::CodexAuth;
+use crate::ExternalAuth;
+use crate::ExternalAuthFuture;
+use crate::ExternalAuthRefreshContext;
+use oauth::session_needs_refresh;
+use storage::SettingsStore;
+use storage::normalize_api_url;
+
+pub const DEFAULT_API_URL: &str = "https://api.meshagent.com";
+
+#[derive(Debug, Clone)]
+pub struct MeshAgentAuth {
+    store: SettingsStore,
+    environment_api_url: Option<String>,
+    client: HttpClient,
+}
+
+impl ExternalAuth for MeshAgentAuth {
+    fn resolve(&self) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(async move {
+            self.access_token(/*force_refresh*/ false)
+                .await
+                .map(|token| CodexAuth::from_api_key(&token))
+        })
+    }
+
+    fn refresh(&self, _context: ExternalAuthRefreshContext) -> ExternalAuthFuture<'_, CodexAuth> {
+        Box::pin(async move {
+            self.access_token(/*force_refresh*/ true)
+                .await
+                .map(|token| CodexAuth::from_api_key(&token))
+        })
+    }
+}
+
+impl MeshAgentAuth {
+    pub fn from_environment() -> io::Result<Self> {
+        let home = std::env::var_os("HOME")
+            .map(PathBuf::from)
+            .ok_or_else(|| io::Error::other("HOME is not set"))?;
+        Self::new(
+            home.join(".meshagent/settings.json"),
+            normalize_api_url(std::env::var("MESHAGENT_API_URL").ok().as_deref()),
+        )
+    }
+
+    fn new(settings_path: PathBuf, environment_api_url: Option<String>) -> io::Result<Self> {
+        let client = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault)
+            .build_client(DEFAULT_API_URL, ClientRouteClass::Auth)
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        Ok(Self {
+            store: SettingsStore::new(settings_path),
+            environment_api_url,
+            client,
+        })
+    }
+
+    pub fn resolved_api_url(&self, explicit_api_url: Option<&str>) -> String {
+        normalize_api_url(explicit_api_url)
+            .or_else(|| self.environment_api_url.clone())
+            .or_else(|| {
+                self.store
+                    .active_user()
+                    .ok()
+                    .flatten()
+                    .and_then(|(_, user)| normalize_api_url(user.api_url.as_deref()))
+            })
+            .unwrap_or_else(|| DEFAULT_API_URL.to_string())
+    }
+
+    pub fn accounts(&self) -> io::Result<Vec<MeshAgentAccount>> {
+        self.store.accounts(DEFAULT_API_URL)
+    }
+
+    pub fn active_account(&self) -> io::Result<Option<MeshAgentAccount>> {
+        self.store.active_account(DEFAULT_API_URL)
+    }
+
+    pub fn switch_account(&self, selector: &str) -> io::Result<MeshAgentAccount> {
+        self.store.switch_account(selector, DEFAULT_API_URL)
+    }
+
+    pub fn logout(&self) -> io::Result<bool> {
+        self.store.logout()
+    }
+
+    pub fn set_active_project(&self, project_id: &str) -> io::Result<()> {
+        self.store.set_active_project(project_id)
+    }
+
+    pub async fn access_token(&self, force_refresh: bool) -> io::Result<String> {
+        if self
+            .store
+            .active_user()?
+            .is_none_or(|(_, user)| user.project.active_project.is_none())
+        {
+            return Err(io::Error::other(
+                "no active MeshAgent project; run `codex project activate`",
+            ));
+        }
+        self.session_access_token(force_refresh).await
+    }
+
+    async fn session_access_token(&self, force_refresh: bool) -> io::Result<String> {
+        let (user_id, user) = self
+            .store
+            .active_user()?
+            .ok_or_else(|| io::Error::other("not logged in to MeshAgent"))?;
+        let session = user
+            .session
+            .ok_or_else(|| io::Error::other("not logged in to MeshAgent"))?;
+        if !force_refresh && !session_needs_refresh(&session) {
+            return session
+                .access_token
+                .filter(|token| !token.is_empty())
+                .ok_or_else(|| io::Error::other("MeshAgent access token is missing"));
+        }
+        let api_url = self.resolved_api_url(None);
+        let refreshed = self.refresh_session(&session, &api_url).await?;
+        let access_token = refreshed
+            .access_token
+            .clone()
+            .ok_or_else(|| io::Error::other("MeshAgent token refresh returned no access token"))?;
+        self.store.replace_session(&user_id, refreshed)?;
+        Ok(access_token)
+    }
+
+    pub async fn activate_project(&self, selector: &str) -> io::Result<MeshAgentProject> {
+        let selector = selector.trim();
+        let projects = self.projects().await?;
+        let exact_id = projects.iter().find(|project| project.id == selector);
+        let project = if let Some(project) = exact_id {
+            project.clone()
+        } else {
+            let matches = projects
+                .iter()
+                .filter(|project| {
+                    project.name.eq_ignore_ascii_case(selector)
+                        || project
+                            .project_key
+                            .as_deref()
+                            .is_some_and(|key| key.eq_ignore_ascii_case(selector))
+                })
+                .collect::<Vec<_>>();
+            match matches.as_slice() {
+                [project] => (*project).clone(),
+                [] => {
+                    return Err(io::Error::other(format!(
+                        "no MeshAgent project matches `{selector}`"
+                    )));
+                }
+                _ => {
+                    return Err(io::Error::other(format!(
+                        "MeshAgent project selector `{selector}` is ambiguous"
+                    )));
+                }
+            }
+        };
+        self.set_active_project(&project.id)?;
+        Ok(project)
+    }
+}
+
+#[cfg(test)]
+#[path = "meshagent_tests.rs"]
+mod tests;
