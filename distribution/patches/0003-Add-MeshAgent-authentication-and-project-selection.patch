+            Err(error) => {
+                eprintln!("Error switching MeshAgent account: {error}");
                 std::process::exit(1);
             }
+        },
+    };
+    match auth.switch_account(&selector) {
+        Ok(account) => {
+            let identity = account.email.unwrap_or(account.user_id);
+            eprintln!("Active MeshAgent account: {identity}");
+            std::process::exit(0);
+        }
+        Err(error) => {
+            eprintln!("Error switching MeshAgent account: {error}");
+            std::process::exit(1);
+        }
+    }
+}
+
+fn print_meshagent_accounts(accounts: &[codex_login::meshagent::MeshAgentAccount]) {
+    if accounts.is_empty() {
+        println!("No saved MeshAgent accounts.");
+        return;
+    }
+    for account in accounts {
+        let marker = if account.active { "*" } else { " " };
+        let label = account
+            .display_name
+            .as_deref()
+            .or(account.email.as_deref())
+            .unwrap_or(&account.user_id);
+        println!(
+            "{marker} {label} [{}] @ {}",
+            account.user_id, account.api_url
+        );
+    }
+}
+
+pub async fn run_meshagent_project_list() -> ! {
+    let auth = meshagent_auth_or_exit();
+    let active_project = auth
+        .active_account()
+        .unwrap_or_else(|error| {
+            eprintln!("Error loading active MeshAgent account: {error}");
+            std::process::exit(1);
+        })
+        .and_then(|account| account.active_project);
+    match auth.projects().await {
+        Ok(projects) => {
+            if projects.is_empty() {
+                eprintln!("No MeshAgent projects are available");
+                std::process::exit(0);
+            }
+            for project in projects {
+                let marker = if active_project.as_deref() == Some(project.id.as_str()) {
+                    "*"
+                } else {
+                    " "
+                };
+                match project.project_key.as_deref() {
+                    Some(key) => println!("{marker} {}\t{}\t{key}", project.id, project.name),
+                    None => println!("{marker} {}\t{}", project.id, project.name),
+                }
+            }
+            std::process::exit(0);
+        }
+        Err(error) => {
+            eprintln!("Error listing MeshAgent projects: {error}");
+            std::process::exit(1);
+        }
+    }
+}
+
+pub async fn run_meshagent_project_activate(selector: Option<String>) -> ! {
+    let auth = meshagent_auth_or_exit();
+    let selector = match selector {
+        Some(selector) => selector,
+        None => {
+            let projects = auth.projects().await.unwrap_or_else(|error| {
+                eprintln!("Error listing MeshAgent projects: {error}");
+                std::process::exit(1);
+            });
+            select_meshagent_project(&projects).unwrap_or_else(|error| {
+                eprintln!("Error selecting MeshAgent project: {error}");
+                std::process::exit(1);
+            })
+        }
+    };
+    match auth.activate_project(&selector).await {
+        Ok(project) => {
+            eprintln!(
+                "Active MeshAgent project: {} ({})",
+                project.name, project.id
+            );
+            std::process::exit(0);
+        }
+        Err(error) => {
+            eprintln!("Error activating MeshAgent project: {error}");
+            std::process::exit(1);
+        }
+    }
+}
+
+fn select_meshagent_project(projects: &[MeshAgentProject]) -> std::io::Result<String> {
+    match projects {
+        [] => {
+            return Err(std::io::Error::other(
+                "this account has no available projects",
+            ));
+        }
+        [project] => return Ok(project.id.clone()),
+        _ => {}
+    }
+    if !std::io::stdin().is_terminal() {
+        return Err(std::io::Error::other(
+            "multiple projects are available; specify one or run from an interactive terminal",
+        ));
+    }
+    eprintln!("Choose a MeshAgent project:");
+    for (index, project) in projects.iter().enumerate() {
+        eprintln!("  {}. {} ({})", index + 1, project.name, project.id);
+    }
+    prompt_index(projects.len()).map(|index| projects[index].id.clone())
+}
+
+fn select_meshagent_account(auth: &MeshAgentAuth) -> std::io::Result<String> {
+    let accounts = auth.accounts()?;
+    if accounts.is_empty() {
+        return Err(std::io::Error::other("no saved MeshAgent accounts"));
+    }
+    eprintln!("Choose a MeshAgent account:");
+    for (index, account) in accounts.iter().enumerate() {
+        let label = account
+            .email
+            .as_deref()
+            .or(account.display_name.as_deref())
+            .unwrap_or(&account.user_id);
+        eprintln!("  {}. {} ({})", index + 1, label, account.api_url);
+    }
+    prompt_index(accounts.len()).map(|index| accounts[index].user_id.clone())
+}
+
+fn prompt_index(count: usize) -> std::io::Result<usize> {
+    eprint!("Selection: ");
+    std::io::stderr().flush()?;
+    let mut input = String::new();
+    std::io::stdin().read_line(&mut input)?;
+    let selected = input
+        .trim()
+        .parse::<usize>()
+        .ok()
+        .filter(|selected| (1..=count).contains(selected))
+        .ok_or_else(|| std::io::Error::other("invalid selection"))?;
+    Ok(selected - 1)
+}
+
+fn meshagent_auth_or_exit() -> MeshAgentAuth {
+    MeshAgentAuth::from_environment().unwrap_or_else(|error| {
+        eprintln!("Error loading MeshAgent authentication: {error}");
+        std::process::exit(1);
+    })
+}
