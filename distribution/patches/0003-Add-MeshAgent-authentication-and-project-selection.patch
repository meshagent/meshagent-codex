+impl MeshAgentAuth {
+    pub async fn projects(&self) -> io::Result<Vec<MeshAgentProject>> {
+        let token = self.session_access_token(/*force_refresh*/ false).await?;
+        let api_url = self.resolved_api_url(None);
+        let response = self
+            .client
+            .get(format!("{api_url}/accounts/projects"))
+            .bearer_auth(&token)
+            .send()
+            .await
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        let projects: ProjectsResponse =
+            parse_json_response(response, "MeshAgent projects").await?;
+        Ok(projects.projects)
+    }
+
+    pub fn start_login(&self, explicit_api_url: Option<&str>) -> io::Result<MeshAgentLoginAttempt> {
+        let api_url = self.resolved_api_url(explicit_api_url);
+        let code_verifier = random_base64url(32);
+        let code_challenge = URL_SAFE_NO_PAD.encode(Sha256::digest(code_verifier.as_bytes()));
+        let expected_state = random_base64url(16);
+        let client_id = oauth_client_id()?;
+        let scopes = oauth_scopes();
+        let mut auth_url = Url::parse(&format!("{api_url}/oauth/authorize"))
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        auth_url.query_pairs_mut().extend_pairs([
+            ("response_type", "code"),
+            ("client_id", client_id.as_str()),
+            ("redirect_uri", REDIRECT_URL),
+            ("scope", scopes.as_str()),
+            ("code_challenge", code_challenge.as_str()),
+            ("code_challenge_method", "S256"),
+            ("state", expected_state.as_str()),
+        ]);
+        let server =
+            Server::http("127.0.0.1:8765").map_err(|error| io::Error::other(error.to_string()))?;
+        let canceled = Arc::new(AtomicBool::new(false));
+        Ok(MeshAgentLoginAttempt {
+            auth_url: auth_url.to_string(),
+            api_url,
+            code_verifier,
+            expected_state,
+            server,
+            auth: self.clone(),
+            canceled,
+        })
+    }
+
+    pub(super) async fn refresh_session(
+        &self,
+        session: &StoredSession,
+        api_url: &str,
+    ) -> io::Result<StoredSession> {
+        let refresh_token = session
+            .refresh_token
+            .as_deref()
+            .filter(|token| !token.is_empty())
+            .ok_or_else(|| io::Error::other("no MeshAgent refresh token is available"))?;
+        let mut fields = vec![
+            ("grant_type", "refresh_token".to_string()),
+            ("refresh_token", refresh_token.to_string()),
+            ("client_id", oauth_client_id()?),
+        ];
+        if let Some(client_secret) = oauth_client_secret() {
+            fields.push(("client_secret", client_secret));
+        }
+        let response = self
+            .post_form(&format!("{api_url}/oauth/token"), &fields)
+            .await?;
+        let token: OAuthTokenResponse =
+            parse_json_response(response, "MeshAgent token refresh").await?;
+        stored_session(token, Some(refresh_token))
+    }
+
+    async fn post_form(
+        &self,
+        url: &str,
+        fields: &[(&str, String)],
+    ) -> io::Result<codex_http_client::HttpResponse> {
+        let body = url::form_urlencoded::Serializer::new(String::new())
+            .extend_pairs(fields.iter().map(|(key, value)| (*key, value.as_str())))
+            .finish();
+        self.client
+            .post(url)
+            .header("accept", "application/json")
+            .header("content-type", "application/x-www-form-urlencoded")
+            .body(body)
+            .send()
+            .await
+            .map_err(|error| io::Error::other(error.to_string()))
+    }
+}
