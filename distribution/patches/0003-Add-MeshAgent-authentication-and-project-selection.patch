+pub(crate) fn runtime_provider_info(
+    info: ModelProviderInfo,
+) -> codex_protocol::error::Result<ModelProviderInfo> {
+    if !info.is_meshagent() {
+        return Ok(info);
+    }
+    let auth = MeshAgentAuth::from_environment().map_err(|error| {
+        CodexErr::UnsupportedOperation(format!("could not load MeshAgent authentication: {error}"))
+    })?;
+    let api_url = auth.resolved_api_url(None);
+    let account = auth
+        .active_account()
+        .map_err(|error| {
+            CodexErr::UnsupportedOperation(format!(
+                "could not load the active MeshAgent account: {error}"
+            ))
+        })?
+        .filter(|account| account.authenticated)
+        .ok_or_else(|| {
+            CodexErr::UnsupportedOperation(
+                "not logged in to MeshAgent; run `codex login`".to_string(),
+            )
+        })?;
+    let project_id = account.active_project.ok_or_else(|| {
+        CodexErr::UnsupportedOperation(
+            "no active MeshAgent project; run `codex project activate`".to_string(),
+        )
+    })?;
+    Ok(meshagent_routing_info(info, &api_url, &project_id))
+}
