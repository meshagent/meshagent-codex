+use super::MeshAgentAuth;
+use super::storage::MeshAgentAccount;
+use super::storage::StoredSession;
+use super::storage::StoredUserProfile;
+use base64::Engine;
+use base64::engine::general_purpose::URL_SAFE_NO_PAD;
+use rand::RngCore;
+use serde::Deserialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::collections::BTreeMap;
+use std::io;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+use tiny_http::Response;
+use tiny_http::Server;
+use url::Url;
+
+const DEFAULT_OAUTH_CLIENT_ID: &str = "p8xy1ZUi73jJUJbNfTg92HUSDpCSZJcc";
+const REDIRECT_URL: &str = "http://localhost:8765/callback";
+const FULL_OAUTH_SCOPE: &str = "profile:read profile:write project/* room/* users:create users:read users:update users:delete projects:read projects:update projects:iam.read projects:iam.write projects:billing.read projects:billing.write rooms:create rooms:read rooms:connect rooms:update rooms:delete agents:create agents:read agents:update agents:delete agents:run agents:sessions.read mailboxes:create mailboxes:read mailboxes:update mailboxes:delete routes:create routes:read routes:update routes:delete scheduledTasks:create scheduledTasks:read scheduledTasks:update scheduledTasks:delete services:create services:read services:update services:delete repositories:create repositories:read repositories:update repositories:delete apiKeys:create apiKeys:read apiKeys:delete serviceAccounts:create serviceAccounts:read serviceAccounts:update serviceAccounts:delete oauthClients:create oauthClients:read oauthClients:update oauthClients:delete llm:invoke llm:usage.read llm:logs.read llm:logs.write secrets:read secrets:write secrets:delete secrets:grant secrets:proxy";
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+pub struct MeshAgentProject {
+    pub id: String,
+    pub name: String,
+    #[serde(default)]
+    pub project_key: Option<String>,
+}
+
+#[derive(Debug)]
+pub struct MeshAgentLoginResult {
+    pub account: MeshAgentAccount,
+    pub projects: Vec<MeshAgentProject>,
+}
+
+pub struct MeshAgentLoginAttempt {
+    pub auth_url: String,
+    api_url: String,
+    code_verifier: String,
+    expected_state: String,
+    server: Server,
+    auth: MeshAgentAuth,
+    canceled: Arc<AtomicBool>,
+}
+
+#[derive(Debug, Clone)]
+pub struct MeshAgentLoginCancel {
+    canceled: Arc<AtomicBool>,
+}
+
+impl MeshAgentLoginCancel {
+    pub fn cancel(&self) {
+        self.canceled.store(true, Ordering::Release);
+    }
+}
+
+#[derive(Debug, Deserialize)]
+struct OAuthTokenResponse {
+    access_token: String,
+    #[serde(default)]
+    refresh_token: Option<String>,
+    #[serde(default = "default_token_type")]
+    token_type: String,
+    #[serde(default)]
+    expires_in: Option<i64>,
+    #[serde(default)]
+    scope: Option<String>,
+    #[serde(default)]
+    id_token: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct ProfileResponse {
+    id: String,
+    #[serde(default)]
+    first_name: Option<String>,
+    #[serde(default)]
+    last_name: Option<String>,
+    #[serde(default)]
+    email: Option<String>,
+}
+
+#[derive(Debug, Deserialize)]
+struct ProjectsResponse {
+    #[serde(default)]
+    projects: Vec<MeshAgentProject>,
+}
+
+impl MeshAgentAuth {
+    pub async fn projects(&self) -> io::Result<Vec<MeshAgentProject>> {
+        let token = self.session_access_token(/*force_refresh*/ false).await?;
+        let api_url = self.resolved_api_url(None);
+        let response = self
+            .client
+            .get(format!("{api_url}/accounts/projects"))
+            .bearer_auth(&token)
+            .send()
+            .await
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        let projects: ProjectsResponse =
+            parse_json_response(response, "MeshAgent projects").await?;
+        Ok(projects.projects)
+    }
+
+    pub fn start_login(&self, explicit_api_url: Option<&str>) -> io::Result<MeshAgentLoginAttempt> {
+        let api_url = self.resolved_api_url(explicit_api_url);
+        let code_verifier = random_base64url(32);
+        let code_challenge = URL_SAFE_NO_PAD.encode(Sha256::digest(code_verifier.as_bytes()));
+        let expected_state = random_base64url(16);
+        let client_id = oauth_client_id()?;
+        let scopes = oauth_scopes();
+        let mut auth_url = Url::parse(&format!("{api_url}/oauth/authorize"))
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        auth_url.query_pairs_mut().extend_pairs([
+            ("response_type", "code"),
+            ("client_id", client_id.as_str()),
+            ("redirect_uri", REDIRECT_URL),
+            ("scope", scopes.as_str()),
+            ("code_challenge", code_challenge.as_str()),
+            ("code_challenge_method", "S256"),
+            ("state", expected_state.as_str()),
+        ]);
+        let server =
+            Server::http("127.0.0.1:8765").map_err(|error| io::Error::other(error.to_string()))?;
+        let canceled = Arc::new(AtomicBool::new(false));
+        Ok(MeshAgentLoginAttempt {
+            auth_url: auth_url.to_string(),
+            api_url,
+            code_verifier,
+            expected_state,
+            server,
+            auth: self.clone(),
+            canceled,
+        })
+    }
+
+    pub(super) async fn refresh_session(
+        &self,
+        session: &StoredSession,
+        api_url: &str,
+    ) -> io::Result<StoredSession> {
+        let refresh_token = session
+            .refresh_token
+            .as_deref()
+            .filter(|token| !token.is_empty())
+            .ok_or_else(|| io::Error::other("no MeshAgent refresh token is available"))?;
+        let mut fields = vec![
+            ("grant_type", "refresh_token".to_string()),
+            ("refresh_token", refresh_token.to_string()),
+            ("client_id", oauth_client_id()?),
+        ];
+        if let Some(client_secret) = oauth_client_secret() {
+            fields.push(("client_secret", client_secret));
+        }
+        let response = self
+            .post_form(&format!("{api_url}/oauth/token"), &fields)
+            .await?;
+        let token: OAuthTokenResponse =
+            parse_json_response(response, "MeshAgent token refresh").await?;
+        stored_session(token, Some(refresh_token))
+    }
+
+    async fn post_form(
+        &self,
+        url: &str,
+        fields: &[(&str, String)],
+    ) -> io::Result<codex_http_client::HttpResponse> {
+        let body = url::form_urlencoded::Serializer::new(String::new())
+            .extend_pairs(fields.iter().map(|(key, value)| (*key, value.as_str())))
+            .finish();
+        self.client
+            .post(url)
+            .header("accept", "application/json")
+            .header("content-type", "application/x-www-form-urlencoded")
+            .body(body)
+            .send()
+            .await
+            .map_err(|error| io::Error::other(error.to_string()))
+    }
+}
+
+impl MeshAgentLoginAttempt {
+    pub fn open_browser(&self) -> io::Result<()> {
+        webbrowser::open(&self.auth_url)
+            .map(|_| ())
+            .map_err(|error| io::Error::other(error.to_string()))
+    }
+
+    pub fn cancel_handle(&self) -> MeshAgentLoginCancel {
+        MeshAgentLoginCancel {
+            canceled: Arc::clone(&self.canceled),
+        }
+    }
+
+    pub async fn complete(self) -> io::Result<MeshAgentLoginResult> {
+        let expected_state = self.expected_state.clone();
+        let server = self.server;
+        let canceled = Arc::clone(&self.canceled);
+        let code =
+            tokio::task::spawn_blocking(move || wait_for_code(server, &expected_state, &canceled))
+                .await
+                .map_err(|error| io::Error::other(error.to_string()))??;
+        let mut fields = vec![
+            ("grant_type", "authorization_code".to_string()),
+            ("code", code),
+            ("redirect_uri", REDIRECT_URL.to_string()),
+            ("client_id", oauth_client_id()?),
+            ("code_verifier", self.code_verifier),
+        ];
+        if let Some(client_secret) = oauth_client_secret() {
+            fields.push(("client_secret", client_secret));
+        }
+        let response = self
+            .auth
+            .post_form(&format!("{}/oauth/token", self.api_url), &fields)
+            .await?;
+        let token: OAuthTokenResponse = parse_json_response(response, "MeshAgent login").await?;
+        let session = stored_session(token, /*existing_refresh_token*/ None)?;
+        let access_token = session
+            .access_token
+            .as_deref()
+            .ok_or_else(|| io::Error::other("MeshAgent login returned no access token"))?;
+        let profile_response = self
+            .auth
+            .client
+            .get(format!("{}/accounts/profiles/me", self.api_url))
+            .bearer_auth(access_token)
+            .send()
+            .await
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        let profile: ProfileResponse =
+            parse_json_response(profile_response, "MeshAgent profile").await?;
+        let projects_response = self
+            .auth
+            .client
+            .get(format!("{}/accounts/projects", self.api_url))
+            .bearer_auth(access_token)
+            .send()
+            .await
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        let projects: ProjectsResponse =
+            parse_json_response(projects_response, "MeshAgent projects").await?;
+        let project_ids = projects
+            .projects
+            .iter()
+            .map(|project| project.id.clone())
+            .collect::<Vec<_>>();
+        let account = self.auth.store.save_session(
+            StoredUserProfile {
+                id: profile.id,
+                first_name: profile.first_name,
+                last_name: profile.last_name,
+                email: profile.email,
+            },
+            self.api_url,
+            session,
+            &project_ids,
+        )?;
+        Ok(MeshAgentLoginResult {
+            account,
+            projects: projects.projects,
+        })
+    }
+}
+
+async fn parse_json_response<T: for<'de> Deserialize<'de>>(
+    response: codex_http_client::HttpResponse,
+    operation: &str,
+) -> io::Result<T> {
+    let status = response.status();
+    let body = response
+        .text()
+        .await
+        .map_err(|error| io::Error::other(error.to_string()))?;
+    if !status.is_success() {
+        return Err(io::Error::other(format!(
+            "{operation} failed with HTTP {}: {body}",
+            status.as_u16()
+        )));
+    }
+    serde_json::from_str(&body).map_err(|error| io::Error::other(error.to_string()))
+}
+
+fn wait_for_code(
+    server: Server,
+    expected_state: &str,
+    canceled: &AtomicBool,
+) -> io::Result<String> {
+    loop {
+        if canceled.load(Ordering::Acquire) {
+            return Err(io::Error::new(
+                io::ErrorKind::Interrupted,
+                "MeshAgent login canceled",
+            ));
+        }
+        let request = server
+            .recv_timeout(Duration::from_millis(100))
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        let Some(request) = request else {
+            continue;
+        };
+        let callback_url = Url::parse(&format!("http://localhost{}", request.url()))
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        let params = callback_url
+            .query_pairs()
+            .map(|(key, value)| (key.into_owned(), value.into_owned()))
+            .collect::<BTreeMap<_, _>>();
+        let code = match validate_callback_params(&params, expected_state) {
+            Ok(code) => code,
+            Err(CallbackValidationError::StateMismatch) => {
+                let _ = request.respond(
+                    Response::from_string("State mismatch. Close this tab.").with_status_code(400),
+                );
+                continue;
+            }
+            Err(CallbackValidationError::MissingCode) => {
+                let _ =
+                    request.respond(Response::from_string("Missing 'code'.").with_status_code(400));
+                continue;
+            }
+        };
+        request
+            .respond(Response::from_string("You may close this tab."))
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        return Ok(code);
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum CallbackValidationError {
+    StateMismatch,
+    MissingCode,
+}
+
+fn validate_callback_params(
+    params: &BTreeMap<String, String>,
+    expected_state: &str,
+) -> Result<String, CallbackValidationError> {
+    if params.get("state").map(String::as_str) != Some(expected_state) {
+        return Err(CallbackValidationError::StateMismatch);
+    }
+    params
+        .get("code")
+        .filter(|code| !code.is_empty())
+        .cloned()
+        .ok_or(CallbackValidationError::MissingCode)
+}
+
+fn stored_session(
+    response: OAuthTokenResponse,
+    existing_refresh_token: Option<&str>,
+) -> io::Result<StoredSession> {
+    let expires_in = response.expires_in.unwrap_or(3600);
+    Ok(StoredSession {
+        access_token: Some(response.access_token),
+        refresh_token: response
+            .refresh_token
+            .or_else(|| existing_refresh_token.map(str::to_string)),
+        expires_at: Some(current_timestamp()? + (expires_in - 30).max(0)),
+        token_type: response.token_type,
+        scope: response.scope,
+        id_token: response.id_token,
+    })
+}
+
+pub(super) fn session_needs_refresh(session: &StoredSession) -> bool {
+    session
+        .expires_at
+        .is_none_or(|expires_at| expires_at <= current_timestamp().unwrap_or(0) + 5 * 60)
+}
+
+fn current_timestamp() -> io::Result<i64> {
+    let seconds = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|error| io::Error::other(error.to_string()))?
+        .as_secs();
+    i64::try_from(seconds).map_err(|error| io::Error::other(error.to_string()))
+}
+
+fn random_base64url(length: usize) -> String {
+    let mut bytes = vec![0_u8; length];
+    rand::rng().fill_bytes(&mut bytes);
+    URL_SAFE_NO_PAD.encode(bytes)
+}
+
+fn oauth_client_id() -> io::Result<String> {
+    match std::env::var("MESHAGENT_OAUTH_CLIENT_ID") {
+        Ok(value) if value.is_empty() => {
+            Err(io::Error::other("MESHAGENT_OAUTH_CLIENT_ID is not set"))
+        }
+        Ok(value) => Ok(value),
+        Err(_) => Ok(DEFAULT_OAUTH_CLIENT_ID.to_string()),
+    }
+}
+
+fn oauth_client_secret() -> Option<String> {
+    std::env::var("MESHAGENT_OAUTH_CLIENT_SECRET").ok()
+}
+
+fn oauth_scopes() -> String {
+    std::env::var("MESHAGENT_OAUTH_SCOPES").unwrap_or_else(|_| FULL_OAUTH_SCOPE.to_string())
+}
+
+fn default_token_type() -> String {
+    "Bearer".to_string()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::CallbackValidationError;
+    use super::validate_callback_params;
+    use std::collections::BTreeMap;
+
+    #[test]
+    fn callback_requires_matching_oauth_state() {
+        let params = BTreeMap::from([
+            ("code".to_string(), "authorization-code".to_string()),
+            ("state".to_string(), "unexpected".to_string()),
+        ]);
+
+        assert_eq!(
+            validate_callback_params(&params, "expected"),
+            Err(CallbackValidationError::StateMismatch)
+        );
+    }
+
+    #[test]
+    fn callback_requires_nonempty_authorization_code() {
+        let params = BTreeMap::from([("state".to_string(), "expected".to_string())]);
+
+        assert_eq!(
+            validate_callback_params(&params, "expected"),
+            Err(CallbackValidationError::MissingCode)
+        );
+    }
+
+    #[test]
+    fn callback_returns_code_for_matching_state() {
+        let params = BTreeMap::from([
+            ("code".to_string(), "authorization-code".to_string()),
+            ("state".to_string(), "expected".to_string()),
+        ]);
+
+        assert_eq!(
+            validate_callback_params(&params, "expected"),
+            Ok("authorization-code".to_string())
+        );
+    }
+}
diff --git a/codex-rs/login/src/meshagent/storage.rs b/codex-rs/login/src/meshagent/storage.rs
new file mode 100644
index 0000000..0b2ef91
--- /dev/null
+++ b/codex-rs/login/src/meshagent/storage.rs
@@ -0,0 +1,424 @@
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::BTreeMap;
+use std::fs;
+use std::io;
+use std::io::Write;
+use std::path::PathBuf;
+
+pub(super) const LOCAL_STATE_USER_ID: &str = "__local__";
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq)]
+pub(super) struct StoredSession {
+    #[serde(default)]
+    pub access_token: Option<String>,
+    #[serde(default)]
+    pub refresh_token: Option<String>,
+    #[serde(default)]
+    pub expires_at: Option<i64>,
+    #[serde(default = "default_token_type")]
+    pub token_type: String,
+    #[serde(default)]
+    pub scope: Option<String>,
+    #[serde(default)]
+    pub id_token: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, Deserialize, Serialize, PartialEq, Eq)]
+pub(super) struct StoredProjectSettings {
+    #[serde(default)]
+    pub active_project: Option<String>,
+    #[serde(default)]
+    pub active_api_keys: BTreeMap<String, String>,
+    #[serde(default)]
+    pub llm_proxy_bearer_token: Option<String>,
+}
+
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq)]
+pub(super) struct StoredUserProfile {
+    pub id: String,
+    #[serde(default)]
+    pub first_name: Option<String>,
+    #[serde(default)]
+    pub last_name: Option<String>,
+    #[serde(default)]
+    pub email: Option<String>,
+}
+
+#[derive(Debug, Clone, Default, Deserialize, Serialize, PartialEq, Eq)]
+pub(super) struct StoredUserSettings {
+    #[serde(default)]
+    pub profile: Option<StoredUserProfile>,
+    #[serde(default)]
+    pub api_url: Option<String>,
+    #[serde(default)]
+    pub session: Option<StoredSession>,
+    #[serde(default)]
+    pub project: StoredProjectSettings,
+}
+
+#[derive(Debug, Clone, Default, Deserialize, Serialize, PartialEq, Eq)]
+pub(super) struct CliSettings {
+    #[serde(default)]
+    pub active_user_id: Option<String>,
+    #[serde(default)]
+    pub users: BTreeMap<String, StoredUserSettings>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct MeshAgentAccount {
+    pub user_id: String,
+    pub email: Option<String>,
+    pub display_name: Option<String>,
+    pub api_url: String,
+    pub active_project: Option<String>,
+    pub authenticated: bool,
+    pub active: bool,
+}
+
+#[derive(Debug, Clone)]
+pub(super) struct SettingsStore {
+    path: PathBuf,
+}
+
+impl SettingsStore {
+    pub fn new(path: PathBuf) -> Self {
+        Self { path }
+    }
+
+    pub fn load(&self) -> io::Result<Option<CliSettings>> {
+        if !self.path.exists() {
+            let migrated = self.migrate_legacy_settings()?;
+            if let Some(settings) = &migrated {
+                self.save(settings)?;
+            }
+            return Ok(migrated);
+        }
+        let text = fs::read_to_string(&self.path)?;
+        serde_json::from_str(&text)
+            .map(Some)
+            .map_err(|error| io::Error::other(error.to_string()))
+    }
+
+    fn migrate_legacy_settings(&self) -> io::Result<Option<CliSettings>> {
+        let Some(parent) = self.path.parent() else {
+            return Ok(None);
+        };
+        let session_path = parent.join("session.json");
+        let project_path = parent.join("project.json");
+        let session = read_optional_json::<StoredSession>(&session_path)?;
+        let project = read_optional_json::<StoredProjectSettings>(&project_path)?;
+        if session.is_none() && project.is_none() {
+            return Ok(None);
+        }
+        Ok(Some(CliSettings {
+            active_user_id: Some(LOCAL_STATE_USER_ID.to_string()),
+            users: BTreeMap::from([(
+                LOCAL_STATE_USER_ID.to_string(),
+                StoredUserSettings {
+                    profile: None,
+                    api_url: normalize_api_url(std::env::var("MESHAGENT_API_URL").ok().as_deref()),
+                    session,
+                    project: project.unwrap_or_default(),
+                },
+            )]),
+        }))
+    }
+
+    pub fn save(&self, settings: &CliSettings) -> io::Result<()> {
+        if let Some(parent) = self.path.parent() {
+            fs::create_dir_all(parent)?;
+        }
+        let text = serde_json::to_string_pretty(settings)
+            .map_err(|error| io::Error::other(error.to_string()))?;
+        let mut options = fs::OpenOptions::new();
+        options.create(true).truncate(true).write(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let mut file = options.open(&self.path)?;
+        writeln!(file, "{text}")
+    }
+
+    pub fn accounts(&self, default_api_url: &str) -> io::Result<Vec<MeshAgentAccount>> {
+        let settings = self.load()?.unwrap_or_default();
+        let active = active_user_id(&settings).map(str::to_string);
+        let mut accounts = settings
+            .users
+            .iter()
+            .filter(|(id, user)| id.as_str() != LOCAL_STATE_USER_ID && is_switchable_user(user))
+            .map(|(id, user)| account_from_stored(id, user, active.as_deref(), default_api_url))
+            .collect::<Vec<_>>();
+        accounts.sort_by_key(|account| {
+            (
+                !account.active,
+                account
+                    .email
+                    .clone()
+                    .unwrap_or_else(|| account.user_id.clone()),
+            )
+        });
+        Ok(accounts)
+    }
+
+    pub fn active_account(&self, default_api_url: &str) -> io::Result<Option<MeshAgentAccount>> {
+        let settings = self.load()?.unwrap_or_default();
+        let Some(id) = active_user_id(&settings) else {
+            return Ok(None);
+        };
+        Ok(settings
+            .users
+            .get(id)
+            .map(|user| account_from_stored(id, user, Some(id), default_api_url)))
+    }
+
+    pub fn active_user(&self) -> io::Result<Option<(String, StoredUserSettings)>> {
+        let settings = self.load()?.unwrap_or_default();
+        let Some(id) = active_user_id(&settings) else {
+            return Ok(None);
+        };
+        Ok(settings
+            .users
+            .get(id)
+            .cloned()
+            .map(|user| (id.to_string(), user)))
+    }
+
+    pub fn switch_account(
+        &self,
+        selector: &str,
+        default_api_url: &str,
+    ) -> io::Result<MeshAgentAccount> {
+        let mut settings = self.load()?.unwrap_or_default();
+        let selector = selector.trim();
+        let matches = settings
+            .users
+            .iter()
+            .filter(|(id, user)| {
+                id.as_str() != LOCAL_STATE_USER_ID
+                    && is_switchable_user(user)
+                    && account_matches(id, user, selector)
+            })
+            .map(|(id, _)| id.clone())
+            .collect::<Vec<_>>();
+        let id = match matches.as_slice() {
+            [id] => id.clone(),
+            [] => {
+                return Err(io::Error::other(format!(
+                    "no MeshAgent account matches `{selector}`"
+                )));
+            }
+            _ => {
+                return Err(io::Error::other(format!(
+                    "MeshAgent account selector `{selector}` is ambiguous"
+                )));
+            }
+        };
+        settings.active_user_id = Some(id.clone());
+        self.save(&settings)?;
+        let user = settings
+            .users
+            .get(&id)
+            .ok_or_else(|| io::Error::other("selected MeshAgent account disappeared"))?;
+        Ok(account_from_stored(&id, user, Some(&id), default_api_url))
+    }
+
+    pub fn logout(&self) -> io::Result<bool> {
+        let Some(mut settings) = self.load()? else {
+            return Ok(false);
+        };
+        let Some(id) = active_user_id(&settings).map(str::to_string) else {
+            return Ok(false);
+        };
+        let Some(user) = settings.users.get_mut(&id) else {
+            return Ok(false);
+        };
+        let changed = user.session.take().is_some();
+        if changed {
+            self.save(&settings)?;
+        }
+        Ok(changed)
+    }
+
+    pub fn set_active_project(&self, project_id: &str) -> io::Result<()> {
+        let mut settings = self.load()?.unwrap_or_default();
+        let id = active_user_id(&settings)
+            .map(str::to_string)
+            .ok_or_else(|| io::Error::other("not logged in to MeshAgent"))?;
+        let user = settings
+            .users
+            .get_mut(&id)
+            .ok_or_else(|| io::Error::other("active MeshAgent account is missing"))?;
+        user.project.active_project = Some(project_id.to_string());
+        self.save(&settings)
+    }
+
+    pub fn save_session(
+        &self,
+        profile: StoredUserProfile,
+        api_url: String,
+        session: StoredSession,
+        project_ids: &[String],
+    ) -> io::Result<MeshAgentAccount> {
+        let mut settings = self.load()?.unwrap_or_default();
+        let id = profile.id.clone();
+        let mut prior = settings.users.remove(&id).unwrap_or_default();
+        if id != LOCAL_STATE_USER_ID
+            && let Some(local) = settings.users.remove(LOCAL_STATE_USER_ID)
+        {
+            prior.project = merge_project_settings(&local.project, &prior.project);
+        }
+        let active_project = prior
+            .project
+            .active_project
+            .clone()
+            .filter(|active| project_ids.contains(active))
+            .or_else(|| match project_ids {
+                [only] => Some(only.clone()),
+                _ => None,
+            });
+        settings.users.insert(
+            id.clone(),
+            StoredUserSettings {
+                profile: Some(profile),
+                api_url: Some(api_url.clone()),
+                session: Some(session),
+                project: StoredProjectSettings {
+                    active_project,
+                    ..prior.project
+                },
+            },
+        );
+        settings.active_user_id = Some(id.clone());
+        self.save(&settings)?;
+        let user = settings
+            .users
+            .get(&id)
+            .ok_or_else(|| io::Error::other("failed to save MeshAgent account"))?;
+        Ok(account_from_stored(&id, user, Some(&id), &api_url))
+    }
+
+    pub fn replace_session(&self, user_id: &str, session: StoredSession) -> io::Result<()> {
+        let mut settings = self.load()?.unwrap_or_default();
+        let user = settings
+            .users
+            .get_mut(user_id)
+            .ok_or_else(|| io::Error::other("active MeshAgent account is missing"))?;
+        user.session = Some(session);
+        self.save(&settings)
+    }
+}
+
+fn merge_project_settings(
+    source: &StoredProjectSettings,
+    target: &StoredProjectSettings,
+) -> StoredProjectSettings {
+    let mut active_api_keys = target.active_api_keys.clone();
+    active_api_keys.extend(source.active_api_keys.clone());
+    StoredProjectSettings {
+        active_project: source
+            .active_project
+            .clone()
+            .or_else(|| target.active_project.clone()),
+        active_api_keys,
+        llm_proxy_bearer_token: source
+            .llm_proxy_bearer_token
+            .clone()
+            .or_else(|| target.llm_proxy_bearer_token.clone()),
+    }
+}
+
+fn read_optional_json<T: for<'de> Deserialize<'de>>(
+    path: &std::path::Path,
+) -> io::Result<Option<T>> {
+    if !path.exists() {
+        return Ok(None);
+    }
+    let text = fs::read_to_string(path)?;
+    serde_json::from_str(&text)
+        .map(Some)
+        .map_err(|error| io::Error::other(error.to_string()))
+}
+
+fn active_user_id(settings: &CliSettings) -> Option<&str> {
+    if let Some(id) = settings.active_user_id.as_deref()
+        && settings.users.contains_key(id)
+    {
+        return Some(id);
+    }
+    if settings.users.contains_key(LOCAL_STATE_USER_ID) {
+        return Some(LOCAL_STATE_USER_ID);
+    }
+    if settings.users.len() == 1 {
+        return settings.users.keys().next().map(String::as_str);
+    }
+    None
+}
+
+fn account_matches(id: &str, user: &StoredUserSettings, selector: &str) -> bool {
+    if id.eq_ignore_ascii_case(selector) {
+        return true;
+    }
+    let account = account_from_stored(id, user, Some(id), "");
+    account
+        .email
+        .as_deref()
+        .is_some_and(|email| email.eq_ignore_ascii_case(selector))
+        || account
+            .display_name
+            .as_deref()
+            .is_some_and(|name| name.eq_ignore_ascii_case(selector))
+}
+
+fn is_switchable_user(user: &StoredUserSettings) -> bool {
+    user.profile.is_some()
+        && user
+            .session
+            .as_ref()
+            .and_then(|session| session.access_token.as_deref())
+            .is_some_and(|token| !token.is_empty())
+}
+
+fn account_from_stored(
+    id: &str,
+    user: &StoredUserSettings,
+    active_id: Option<&str>,
+    default_api_url: &str,
+) -> MeshAgentAccount {
+    let display_name = user.profile.as_ref().and_then(|profile| {
+        let name = [profile.first_name.as_deref(), profile.last_name.as_deref()]
+            .into_iter()
+            .flatten()
+            .collect::<Vec<_>>()
+            .join(" ");
+        (!name.is_empty()).then_some(name)
+    });
+    MeshAgentAccount {
+        user_id: id.to_string(),
+        email: user
+            .profile
+            .as_ref()
+            .and_then(|profile| profile.email.clone()),
+        display_name,
+        api_url: normalize_api_url(user.api_url.as_deref())
+            .unwrap_or_else(|| default_api_url.to_string()),
+        active_project: user.project.active_project.clone(),
+        authenticated: user
+            .session
+            .as_ref()
+            .and_then(|session| session.access_token.as_deref())
+            .is_some_and(|token| !token.is_empty()),
+        active: active_id == Some(id),
+    }
+}
+
+pub(super) fn normalize_api_url(value: Option<&str>) -> Option<String> {
+    let value = value?.trim().trim_end_matches('/');
+    (!value.is_empty()).then(|| value.to_string())
+}
+
+fn default_token_type() -> String {
+    "Bearer".to_string()
+}
