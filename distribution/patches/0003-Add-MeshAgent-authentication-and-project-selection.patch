@@ -0,0 +1,321 @@
+use super::storage::CliSettings;
+use super::storage::StoredProjectSettings;
+use super::storage::StoredSession;
+use super::storage::StoredUserProfile;
+use super::storage::StoredUserSettings;
+use super::*;
+use pretty_assertions::assert_eq;
+use std::collections::BTreeMap;
+use tempfile::tempdir;
+use wiremock::Mock;
+use wiremock::MockServer;
+use wiremock::ResponseTemplate;
+use wiremock::matchers::header;
+use wiremock::matchers::method;
+use wiremock::matchers::path;
+
+fn account(id: &str, email: &str, first: &str, api_url: &str) -> StoredUserSettings {
+    StoredUserSettings {
+        profile: Some(StoredUserProfile {
+            id: id.to_string(),
+            first_name: Some(first.to_string()),
+            last_name: Some("User".to_string()),
+            email: Some(email.to_string()),
+        }),
+        api_url: Some(api_url.to_string()),
+        session: Some(StoredSession {
+            access_token: Some(format!("token-{id}")),
+            refresh_token: Some(format!("refresh-{id}")),
+            expires_at: Some(i64::MAX),
+            token_type: "Bearer".to_string(),
+            scope: None,
+            id_token: None,
+        }),
+        project: StoredProjectSettings {
+            active_project: Some(format!("project-{id}")),
+            ..Default::default()
+        },
+    }
+}
+
+fn auth_with(settings: CliSettings) -> (MeshAgentAuth, tempfile::TempDir) {
+    let temp = tempdir().expect("tempdir");
+    let auth = MeshAgentAuth::new(temp.path().join("settings.json"), None).expect("auth");
+    auth.store.save(&settings).expect("save settings");
+    (auth, temp)
+}
+
+fn two_accounts() -> CliSettings {
+    CliSettings {
+        active_user_id: Some("one".to_string()),
+        users: BTreeMap::from([
+            (
+                "one".to_string(),
+                account("one", "one@example.com", "One", "https://one/"),
+            ),
+            (
+                "two".to_string(),
+                account("two", "two@example.com", "Two", "https://two"),
+            ),
+        ]),
+    }
+}
+
+#[test]
+fn api_url_precedence_matches_meshagent_cli() {
+    let (mut auth, _temp) = auth_with(two_accounts());
+    assert_eq!(auth.resolved_api_url(None), "https://one");
+    auth.environment_api_url = Some("https://environment".to_string());
+    assert_eq!(auth.resolved_api_url(None), "https://environment");
+    assert_eq!(
+        auth.resolved_api_url(Some("https://explicit///")),
+        "https://explicit"
+    );
+}
+
+#[test]
+fn switches_accounts_by_id_email_and_display_name() {
+    let (auth, _temp) = auth_with(two_accounts());
+    assert_eq!(auth.switch_account("two").expect("id").user_id, "two");
+    assert_eq!(
+        auth.switch_account("one@example.com")
+            .expect("email")
+            .user_id,
+        "one"
+    );
+    assert_eq!(
+        auth.switch_account("Two User").expect("name").user_id,
+        "two"
+    );
+}
+
+#[test]
+fn logout_clears_only_the_active_session() {
+    let (auth, _temp) = auth_with(two_accounts());
+    assert_eq!(auth.logout().expect("logout"), true);
+    let settings = auth.store.load().expect("settings").expect("settings");
+    assert!(
+        settings
+            .users
+            .get("one")
+            .expect("active account")
+            .session
+            .is_none()
+    );
+    assert!(
+        settings
+            .users
+            .get("two")
+            .expect("other account")
+            .session
+            .is_some()
+    );
+    let switchable = auth.accounts().expect("accounts");
+    assert_eq!(switchable.len(), 1);
+    assert_eq!(switchable[0].user_id, "two");
+}
+
+#[test]
+fn login_migrates_local_project_settings_and_preserves_saved_accounts() {
+    let mut settings = two_accounts();
+    settings.active_user_id = Some(storage::LOCAL_STATE_USER_ID.to_string());
+    settings.users.insert(
+        storage::LOCAL_STATE_USER_ID.to_string(),
+        StoredUserSettings {
+            project: StoredProjectSettings {
+                active_project: Some("project-local".to_string()),
+                active_api_keys: BTreeMap::from([(
+                    "project-local".to_string(),
+                    "key-local".to_string(),
+                )]),
+                llm_proxy_bearer_token: Some("proxy-local".to_string()),
+            },
+            ..Default::default()
+        },
+    );
+    let (auth, _temp) = auth_with(settings);
+
+    let logged_in = auth
+        .store
+        .save_session(
+            StoredUserProfile {
+                id: "three".to_string(),
+                first_name: Some("Three".to_string()),
+                last_name: Some("User".to_string()),
+                email: Some("three@example.com".to_string()),
+            },
+            "https://three".to_string(),
+            account("three", "three@example.com", "Three", "https://three")
+                .session
+                .expect("session"),
+            &["project-local".to_string(), "project-other".to_string()],
+        )
+        .expect("save session");
+
+    assert_eq!(logged_in.user_id, "three");
+    assert_eq!(logged_in.active_project.as_deref(), Some("project-local"));
+    let persisted = auth.store.load().expect("settings").expect("settings");
+    assert!(!persisted.users.contains_key(storage::LOCAL_STATE_USER_ID));
+    assert!(persisted.users.contains_key("one"));
+    assert!(persisted.users.contains_key("two"));
+    let project = &persisted.users.get("three").expect("new account").project;
+    assert_eq!(
+        project
+            .active_api_keys
+            .get("project-local")
+            .map(String::as_str),
+        Some("key-local")
+    );
+    assert_eq!(
+        project.llm_proxy_bearer_token.as_deref(),
+        Some("proxy-local")
+    );
+}
+
+#[tokio::test]
+async fn lists_and_activates_projects_for_active_account() {
+    let server = MockServer::start().await;
+    let mut settings = two_accounts();
+    settings.users.get_mut("one").expect("account").api_url = Some(server.uri());
+    Mock::given(method("GET"))
+        .and(path("/accounts/projects"))
+        .and(header("authorization", "Bearer token-one"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "projects": [
+                {"id": "project-one", "name": "One", "project_key": "one"},
+                {"id": "project-two", "name": "Two", "project_key": "two"}
+            ]
+        })))
+        .expect(2)
+        .mount(&server)
+        .await;
+    let (auth, _temp) = auth_with(settings);
+
+    let projects = auth.projects().await.expect("list projects");
+    assert_eq!(projects.len(), 2);
+    let activated = auth.activate_project("two").await.expect("activate by key");
+    assert_eq!(activated.id, "project-two");
+    assert_eq!(
+        auth.active_account()
+            .expect("active account")
+            .expect("account")
+            .active_project
+            .as_deref(),
+        Some("project-two")
+    );
+}
+
+#[tokio::test]
+async fn refreshes_and_persists_rotated_session_tokens() {
+    let server = MockServer::start().await;
+    let mut settings = two_accounts();
+    let user = settings.users.get_mut("one").expect("account");
+    user.api_url = Some("https://saved.invalid".to_string());
+    user.session.as_mut().expect("session").expires_at = Some(0);
+    Mock::given(method("POST"))
+        .and(path("/oauth/token"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "access_token": "rotated-access",
+            "refresh_token": "rotated-refresh",
+            "token_type": "Bearer",
+            "expires_in": 3600
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let temp = tempdir().expect("tempdir");
+    let auth =
+        MeshAgentAuth::new(temp.path().join("settings.json"), Some(server.uri())).expect("auth");
+    auth.store.save(&settings).expect("save settings");
+
+    assert_eq!(
+        auth.access_token(false).await.expect("refresh token"),
+        "rotated-access"
+    );
+    let (_, user) = auth
+        .store
+        .active_user()
+        .expect("settings")
+        .expect("active user");
+    let session = user.session.expect("persisted session");
+    assert_eq!(session.access_token.as_deref(), Some("rotated-access"));
+    assert_eq!(session.refresh_token.as_deref(), Some("rotated-refresh"));
+}
+
+#[tokio::test]
+async fn external_auth_refresh_forces_rotation_after_unauthorized() {
+    let server = MockServer::start().await;
+    let mut settings = two_accounts();
+    settings.users.get_mut("one").expect("account").api_url = Some(server.uri());
+    Mock::given(method("POST"))
+        .and(path("/oauth/token"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(serde_json::json!({
+            "access_token": "unauthorized-recovery-access",
+            "refresh_token": "unauthorized-recovery-refresh",
+            "token_type": "Bearer",
+            "expires_in": 3600
+        })))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let (auth, _temp) = auth_with(settings);
+
+    let refreshed = ExternalAuth::refresh(
+        &auth,
+        ExternalAuthRefreshContext {
+            reason: crate::ExternalAuthRefreshReason::Unauthorized,
+            previous_account_id: None,
+        },
+    )
+    .await
+    .expect("forced external refresh");
+
+    assert_eq!(
+        refreshed,
+        CodexAuth::from_api_key("unauthorized-recovery-access")
+    );
+    let (_, user) = auth
+        .store
+        .active_user()
+        .expect("settings")
+        .expect("active user");
+    assert_eq!(
+        user.session
+            .expect("persisted session")
+            .refresh_token
+            .as_deref(),
+        Some("unauthorized-recovery-refresh")
+    );
+}
+
+#[test]
+#[serial_test::serial]
+fn login_authorization_url_uses_pkce_state_and_api_override() {
+    let (auth, _temp) = auth_with(two_accounts());
+    let attempt = auth
+        .start_login(Some("https://login.example.test/"))
+        .expect("start login");
+    let url = url::Url::parse(&attempt.auth_url).expect("auth URL");
+    let query = url.query_pairs().collect::<BTreeMap<_, _>>();
+
+    assert_eq!(
+        url.as_str().split('?').next(),
+        Some("https://login.example.test/oauth/authorize")
+    );
+    assert_eq!(
+        query
+            .get("code_challenge_method")
+            .map(std::convert::AsRef::as_ref),
+        Some("S256")
+    );
+    assert!(
+        query
+            .get("code_challenge")
+            .is_some_and(|value| !value.is_empty())
+    );
+    assert!(query.get("state").is_some_and(|value| !value.is_empty()));
+    assert_eq!(
+        query.get("redirect_uri").map(std::convert::AsRef::as_ref),
+        Some("http://localhost:8765/callback")
+    );
+}
