+    fn handle_meshagent_project_key_event(&mut self, key_event: &KeyEvent) -> bool {
+        let mut guard = self.sign_in_state.write().unwrap();
+        let SignInState::MeshAgentProjectChoice(state) = &mut *guard else {
+            return false;
+        };
+        if keys::MOVE_UP.is_pressed(*key_event) {
+            state.selected = state.selected.saturating_sub(1);
+        } else if keys::MOVE_DOWN.is_pressed(*key_event) {
+            state.selected = (state.selected + 1).min(state.projects.len().saturating_sub(1));
+        } else if keys::CONFIRM.is_pressed(*key_event) {
+            let project = state.projects[state.selected].clone();
+            match MeshAgentAuth::from_environment()
+                .and_then(|auth| auth.set_active_project(&project.id))
+            {
+                Ok(()) => *guard = SignInState::MeshAgentSuccess,
+                Err(project_error) => {
+                    drop(guard);
+                    self.set_error(Some(project_error.to_string()));
+                }
+            }
+            self.request_frame.schedule_frame();
+        } else if keys::CANCEL.is_pressed(*key_event) {
+            *guard = SignInState::PickMode;
+        } else {
+            return true;
+        }
+        self.request_frame.schedule_frame();
+        true
+    }
