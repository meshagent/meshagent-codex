+pub async fn run_login_status(cli_config_overrides: CliConfigOverrides) -> ! {
+    let config = load_config_or_exit(cli_config_overrides).await;
+    let meshagent = MeshAgentAuth::from_environment()
+        .and_then(|auth| auth.active_account())
+        .ok()
+        .flatten();
+    let meshagent_authenticated = meshagent
+        .as_ref()
+        .is_some_and(|account| account.authenticated);
+    print_meshagent_status(meshagent);
+    let openai_status = openai_login_status(&config).await;
+    let openai_authenticated = matches!(&openai_status, Ok(Some(_)));
+    match openai_status {
+        Ok(Some(message)) => eprintln!("OpenAI: {message}"),
+        Ok(None) => eprintln!("OpenAI: not logged in"),
+        Err(error) => eprintln!("OpenAI: error checking login status: {error}"),
+    }
+    std::process::exit(if meshagent_authenticated || openai_authenticated {
+        0
+    } else {
+        1
+    });
+}
+
+pub async fn run_login_status_meshagent() -> ! {
+    let account = MeshAgentAuth::from_environment()
+        .and_then(|auth| auth.active_account())
+        .unwrap_or_else(|error| {
+            eprintln!("Error checking MeshAgent login status: {error}");
+            std::process::exit(1);
+        });
+    let authenticated = account
+        .as_ref()
+        .is_some_and(|account| account.authenticated);
+    print_meshagent_status(account);
+    std::process::exit(if authenticated { 0 } else { 1 });
+}
+
+pub async fn run_login_status_openai(cli_config_overrides: CliConfigOverrides) -> ! {
+    let config = load_config_or_exit(cli_config_overrides).await;
+    match openai_login_status(&config).await {
+        Ok(Some(message)) => {
+            eprintln!("{message}");
+            std::process::exit(0);
+        }
+        Ok(None) => {
+            eprintln!("Not logged in");
+            std::process::exit(1);
+        }
+        Err(error) => {
+            eprintln!("Error checking login status: {error}");
+            std::process::exit(1);
+        }
+    }
+}
+
+fn print_meshagent_status(account: Option<codex_login::meshagent::MeshAgentAccount>) {
+    match account.filter(|account| account.authenticated) {
+        Some(account) => {
+            let identity = account.email.unwrap_or(account.user_id);
+            let project = account
+                .active_project
+                .map(|project| format!(" (project: {project})"))
+                .unwrap_or_default();
+            eprintln!("MeshAgent: logged in as {identity}{project}");
+        }
+        None => eprintln!("MeshAgent: not logged in"),
+    }
+}
