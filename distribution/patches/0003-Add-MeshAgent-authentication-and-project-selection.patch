+        *self.sign_in_state.write().unwrap() =
+            SignInState::MeshAgentContinueInBrowser(MeshAgentBrowserState {
+                cancel: attempt.cancel_handle(),
+                auth_url: auth_url.clone(),
+            });
+        if let Err(error) = webbrowser::open(&auth_url) {
+            tracing::warn!("failed to open MeshAgent login URL: {error}");
+        }
+        let sign_in_state = Arc::clone(&self.sign_in_state);
+        let error = Arc::clone(&self.error);
+        let request_frame = self.request_frame.clone();
+        tokio::spawn(async move {
+            match attempt.complete().await {
+                Ok(result) if result.account.active_project.is_some() => {
+                    *error.write().unwrap() = None;
+                    *sign_in_state.write().unwrap() = SignInState::MeshAgentSuccess;
+                }
+                Ok(result) if result.projects.is_empty() => {
+                    *error.write().unwrap() =
+                        Some("This MeshAgent account has no available projects.".to_string());
+                    *sign_in_state.write().unwrap() = SignInState::PickMode;
+                }
+                Ok(result) => {
+                    *error.write().unwrap() = None;
+                    *sign_in_state.write().unwrap() =
+                        SignInState::MeshAgentProjectChoice(MeshAgentProjectChoiceState {
+                            projects: result.projects,
+                            selected: 0,
+                        });
+                }
+                Err(login_error) if login_error.kind() == std::io::ErrorKind::Interrupted => {}
+                Err(login_error) => {
+                    *error.write().unwrap() = Some(login_error.to_string());
+                    *sign_in_state.write().unwrap() = SignInState::PickMode;
+                }
+            }
+            request_frame.schedule_frame();
+        });
+        self.request_frame.schedule_frame();
+    }
