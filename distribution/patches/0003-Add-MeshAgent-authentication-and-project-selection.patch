+//! MeshAgent project selection for the `/project` command.
+
+use super::*;
+use codex_login::meshagent::MeshAgentAuth;
+use codex_login::meshagent::MeshAgentProject;
+
+impl ChatWidget {
+    pub(crate) fn open_meshagent_project_popup(&mut self) {
+        if !self.config.model_provider.is_meshagent() {
+            self.add_error_message(
+                "Project selection is only available with the MeshAgent model provider."
+                    .to_string(),
+            );
+            return;
+        }
+
+        self.add_info_message("Loading MeshAgent projects...".to_string(), None);
+        let tx = self.app_event_tx.clone();
+        std::mem::drop(tokio::spawn(async move {
+            let result = async {
+                let auth = MeshAgentAuth::from_environment().map_err(|error| error.to_string())?;
+                let active_project = auth
+                    .active_account()
+                    .map_err(|error| error.to_string())?
+                    .and_then(|account| account.active_project);
+                let projects = auth.projects().await.map_err(|error| error.to_string())?;
+                Ok((projects, active_project))
+            }
+            .await;
+            tx.send(AppEvent::MeshAgentProjectsLoaded { result });
+        }));
+    }
+
+    pub(crate) fn show_meshagent_project_popup(
+        &mut self,
+        result: Result<(Vec<MeshAgentProject>, Option<String>), String>,
+    ) {
+        let (projects, active_project) = match result {
+            Ok(result) => result,
+            Err(error) => {
+                self.add_error_message(format!("Could not load MeshAgent projects: {error}"));
+                return;
+            }
+        };
+        if projects.is_empty() {
+            self.add_info_message("No MeshAgent projects are available.".to_string(), None);
+            return;
+        }
+
+        let items = projects
+            .into_iter()
+            .map(|project| {
+                let project_id = project.id.clone();
+                let project_name = project.name.clone();
+                let description = project
+                    .project_key
+                    .as_deref()
+                    .map(|key| format!("{key} · {}", project.id))
+                    .or_else(|| Some(project.id.clone()));
+                SelectionItem {
+                    name: project.name,
+                    description,
+                    is_current: active_project.as_deref() == Some(project.id.as_str()),
+                    actions: vec![Box::new(move |tx| {
+                        let result = MeshAgentAuth::from_environment()
+                            .and_then(|auth| auth.set_active_project(&project_id))
+                            .map_err(|error| error.to_string());
+                        tx.send(AppEvent::MeshAgentProjectActivated {
+                            project_id: project_id.clone(),
+                            project_name: project_name.clone(),
+                            result,
+                        });
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                }
+            })
+            .collect();
+        self.bottom_pane.show_selection_view(SelectionViewParams {
+            title: Some("Select MeshAgent Project".to_string()),
+            subtitle: Some(
+                "Applies to subsequent turns; an in-flight turn is unchanged.".to_string(),
+            ),
+            footer_hint: Some(standard_popup_hint_line()),
+            items,
+            is_searchable: true,
+            search_placeholder: Some("Search projects".to_string()),
+            ..Default::default()
+        });
+    }
+
+    pub(crate) fn on_meshagent_project_activated(
+        &mut self,
+        project_id: String,
+        project_name: String,
+        result: Result<(), String>,
+    ) {
+        match result {
+            Ok(()) => self.add_info_message(
+                format!("Active MeshAgent project: {project_name} ({project_id})"),
+                Some("The new project will be used for subsequent turns.".to_string()),
+            ),
+            Err(error) => {
+                self.add_error_message(format!("Could not activate MeshAgent project: {error}"));
+            }
+        }
+    }
+}
