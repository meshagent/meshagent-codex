+                        });
+                }
+                Err(login_error) if login_error.kind() == std::io::ErrorKind::Interrupted => {}
+                Err(login_error) => {
+                    *error.write().unwrap() = Some(login_error.to_string());
+                    *sign_in_state.write().unwrap() = SignInState::PickMode;
+                }
