+use super::*;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn enterprise_cli_package_update_never_requests_confirmation() {
+    let error = update_from_cli(|_| panic!("enterprise update must not copy a CLI package"))
+        .await
+        .expect_err("distribution tooling owns updates");
+    assert_eq!(
+        error.to_string(),
+        "daemon package updates are managed by MeshAgent distribution tooling"
+    );
+}
+
+#[tokio::test]
+async fn enterprise_updater_rejects_scheduled_and_manual_installs() {
+    let home = tempfile::TempDir::new().expect("temporary home");
+    let state = home.path().join(STATE_DIR_NAME);
+    let daemon = Daemon {
+        log_diagnostics: false,
+        socket_path: home.path().join("control.sock"),
+        pid_file: state.join(LEGACY_PID_FILE_NAME),
+        update_pid_file: state.join(LEGACY_UPDATE_PID_FILE_NAME),
+        operation_lock_file: state.join(OPERATION_LOCK_FILE_NAME),
+        settings_file: state.join(SETTINGS_FILE_NAME),
+        managed_codex_bin: managed_codex_bin(home.path()),
+    };
+    let factory = HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault);
+    for result in [
+        update_loop::run(factory.clone(), /*restore_release*/ None).await,
+        update_loop::request_manual_update(&daemon, factory)
+            .await
+            .map(|_| ()),
+    ] {
+        assert_eq!(
+            result
+                .expect_err("enterprise installs are disabled")
+                .to_string(),
+            "standalone updates are disabled in MeshAgent Codex; install updates through the MeshAgent distribution tooling"
+        );
+    }
+    assert_eq!(
+        std::fs::read_dir(home.path())
+            .expect("home entries")
+            .count(),
+        0
+    );
+}
+
+#[tokio::test]
+async fn enterprise_start_requires_the_meshagent_managed_package() {
+    let home = tempfile::TempDir::new().expect("temporary home");
+    let dedicated = home.path().join("packages/app-server-daemon/current/bin");
+    std::fs::create_dir_all(&dedicated).expect("dedicated package");
+    std::fs::write(
+        dedicated.join(if cfg!(windows) { "codex.exe" } else { "codex" }),
+        b"upstream package",
+    )
+    .expect("upstream binary");
+    let state = home.path().join(STATE_DIR_NAME);
+    let daemon = Daemon {
+        log_diagnostics: false,
+        socket_path: home.path().join("control.sock"),
+        pid_file: state.join(LEGACY_PID_FILE_NAME),
+        update_pid_file: state.join(LEGACY_UPDATE_PID_FILE_NAME),
+        operation_lock_file: state.join(OPERATION_LOCK_FILE_NAME),
+        settings_file: state.join(SETTINGS_FILE_NAME),
+        managed_codex_bin: managed_codex_bin(home.path()),
+    };
+    let settings = DaemonSettings::default();
+    let error = prepare_install::prepare(&daemon, &settings)
+        .await
+        .expect_err("upstream package must not be selected");
+    assert!(
+        error
+            .to_string()
+            .contains("MeshAgent Codex distribution helper")
+    );
+    assert!(!home.path().join("packages/standalone").exists());
+    let managed = daemon
+        .managed_codex_bin
+        .parent()
+        .expect("managed directory");
+    std::fs::create_dir_all(managed).expect("managed directory");
+    std::fs::copy(
+        std::env::current_exe().expect("test binary"),
+        &daemon.managed_codex_bin,
+    )
+    .expect("managed binary");
+    prepare_install::prepare(&daemon, &settings)
+        .await
+        .expect("use managed package");
+}
